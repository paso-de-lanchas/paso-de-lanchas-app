# Copia este archivo como .env.local y llénalo. .env.local NUNCA se sube a GitHub.
# Los valores de abajo ya funcionan con `docker compose up -d` en tu computadora.
# Las claves de la nube (Neon, Mercado Pago, Resend, Sentry) NO van aquí: viven en Vercel
# y en los secretos de GitHub. Para desarrollo usa solo credenciales de PRUEBA.

# --- Base de datos (Docker local) ---
DATABASE_URL="postgresql://paso:paso_dev@localhost:5434/paso_lanchas?schema=public"
# Base de pruebas automáticas (se vacía al reiniciar Docker)
DATABASE_URL_TEST="postgresql://paso:paso_test@localhost:5435/paso_lanchas_test?schema=public"

# --- Aplicación ---
APP_URL="http://localhost:3000"
TZ="America/Mexico_City"

# --- Autenticación ---
# Genera uno propio con:  npx auth secret   (o)   openssl rand -base64 32
AUTH_SECRET=""

# --- Firma del QR dinámico (TOTP) ---
# Genera uno propio con:  openssl rand -base64 32
QR_SIGNING_SECRET=""

# --- Correo (Mailpit local: los correos se ven en http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="Paso de Lanchas <no-responder@pasolanchas.test>"

# --- Pagos en línea (modo PRUEBA de Mercado Pago; nunca credenciales reales) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# --- Mapa (OpenFreeMap no necesita clave) ---
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# --- Monitoreo de errores (opcional en local) ---
SENTRY_DSN=""
